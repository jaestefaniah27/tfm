\newlabel{tab:pcb_multidrop}{{4.11}{84}{Integridad del bus multipunto (T3) frente a la velocidad, con SLO~=~0. El escalón entre 460~kbps y 1~Mbps es nítido}{table.caption.180}{}}
\transparent@use{.6}
