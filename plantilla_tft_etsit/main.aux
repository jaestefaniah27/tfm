\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces Velocidad máxima con tasa de error nula en cada bus de la PCB, según el valor del bit SLO. El pin \texttt  {SLO} del LTC2865 es un habilitador de modo lento activo a nivel bajo: con el valor por defecto (0) el limitador de \textit  {slew rate} está activo y limita el driver a 250~kbps nominales, con lo que el bus multipunto alcanza 460~kbps. Desactivándolo (1), los tres buses operan de forma limpia a 4~Mbps.}}{70}{figure.caption.177}\protected@file@percent }
\newlabel{fig:pcb_slo}{{4.17}{70}{Velocidad máxima con tasa de error nula en cada bus de la PCB, según el valor del bit SLO. El pin \texttt {SLO} del LTC2865 es un habilitador de modo lento activo a nivel bajo: con el valor por defecto (0) el limitador de \textit {slew rate} está activo y limita el driver a 250~kbps nominales, con lo que el bus multipunto alcanza 460~kbps. Desactivándolo (1), los tres buses operan de forma limpia a 4~Mbps}{figure.caption.177}{}}
\@writefile{toc}{\contentsline {subsubsection}{Comportamiento del bus multipunto}{70}{section*.179}\protected@file@percent }
